# Copy to .env (never commit .env). The CLI loads it automatically.
# Any OpenAI-compatible chat endpoint works: Google Gemini, OpenAI, Moonshot AI (Kimi), or a local server.

# Google Gemini (free tier). Get a key at https://aistudio.google.com/apikey
# Free-tier prompts may be used to improve Google's products; acceptable for public site QA.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-key-here
LLM_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
LLM_DISABLE_THINKING=true
